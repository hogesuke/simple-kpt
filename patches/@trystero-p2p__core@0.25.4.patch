@@ -43,6 +43,12 @@ var OfferPool = class {
 			const peer = this.pool.shift();
 			if (!peer) break;
 			this.pooled.delete(peer);
+			// [simple-kpt patch] 作成から一定時間が経った接続の申し込みは、ICEの再取得で使い回すと接続できないことがあるため、
+			// 破棄して新しく作り直す（参加から約1分後に新しい参加者が接続できなかった問題への対策）
+			if (peer.isDead || Date.now() - peer.created > offerTtl) {
+				if (!peer.isDead) peer.destroy();
+				continue;
+			}
